[Unit]
Description=Drop unsolicited inbound traffic on the cellular link
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
# nftables.service flushes the whole ruleset when it starts or restarts, so
# load after it and again whenever it restarts.
After=nftables.service
PartOf=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/wwan-firewall.nft
ExecStop=/usr/sbin/nft delete table inet wwan_firewall

[Install]
WantedBy=sysinit.target
